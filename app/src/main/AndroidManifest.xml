<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET in particular must never be added. Ad-free and offline are enforced by
      the platform rather than by convention; NoNetworkPermissionTest and the
      merged-manifest check fail the build if any permission beyond these two appears.

      Both serve the weekly logging reminder: one shows it, one re-arms it after a
      restart. Neither reaches the network.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      ML Kit text recognition (receipt scan) merges these two through its logging
      backend, com.google.android.datatransport:transport-backend-cct. Recognition runs
      on the device and does not need either; without them the logger cannot send.
      The merged-manifest check still fails on any other network permission.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".SakuApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Saku"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Saku">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The weekly alarm. Not exported: no other app can make Saku post it. -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!--
          Re-arms the alarm after a restart, a clock or zone change, or an update. These
          are system broadcasts, so it is exported; all it does is schedule the stored
          reminder again, so a forged intent can do nothing more.
        -->
        <receiver
            android:name=".reminder.ReminderRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
